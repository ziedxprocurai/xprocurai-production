# ============================================
# xProcurAI - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# For production, copy to .env.production and
# adjust values for your Azure VM.
# ============================================

# ---- General ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
# Local dev: PostgreSQL installed on your machine
# Production: self-managed PostgreSQL on Azure VM
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=xprocurai
DATABASE_PASSWORD=xprocurai_secret
DATABASE_NAME=xprocurai_db
# IMPORTANT: .env files don't support variable substitution - use the hardcoded URL below
DATABASE_URL=postgresql://xprocurai:xprocurai_secret@localhost:5432/xprocurai_db?schema=public

# ---- Redis ----
# Local dev: Redis installed on your machine
# Production: self-managed Redis on Azure VM
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT Auth ----
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret
JWT_REFRESH_EXPIRATION=604800

# ---- Google OAuth ----
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ---- API ----
API_PORT=4000
API_PREFIX=api
API_CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=xProcurAI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Production (Azure VM) ----
# Uncomment and set these for production deployment
# DOMAIN=yourdomain.com
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
# PM2_INSTANCES=max
