# ============================================
# xProcurAI - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
#
# DEPLOYMENT STACK:
#   Frontend: Netlify (Next.js)
#   Database: Supabase (managed PostgreSQL)
#   Auth: NextAuth v5 + Google OAuth
#
# For local development, use a local PostgreSQL
# or your Supabase dev project.
# For production, set these in Netlify Dashboard
# under Site Settings > Environment Variables.
# ============================================

# ---- General ----
NODE_ENV=development

# ---- Database (Supabase PostgreSQL) ----
# Local dev: use local PostgreSQL or Supabase dev project
# Production: Supabase production project (set in Netlify env vars)
#
# POOLED connection (for serverless/Netlify Functions):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT connection (for migrations only):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
DATABASE_URL=postgresql://xprocurai:xprocurai_secret@localhost:5432/xprocurai_db
DIRECT_DATABASE_URL=postgresql://xprocurai:xprocurai_secret@localhost:5432/xprocurai_db

# ---- JWT Auth (for backend API token signing) ----
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret
JWT_REFRESH_EXPIRATION=604800

# ---- Google OAuth ----
# Get these from https://console.cloud.google.com/apis/credentials
# IMPORTANT: These are server-side only. Never prefix with NEXT_PUBLIC_
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
# NEXTAUTH_URL must match your deployment URL
NEXTAUTH_SECRET=change-me-to-a-random-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ---- Frontend (Public - safe to expose to browser) ----
NEXT_PUBLIC_APP_NAME=xProcurAI
NEXT_PUBLIC_APP_URL=http://localhost:3000
