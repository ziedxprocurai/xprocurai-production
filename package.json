{
  "name": "xprocurai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@xprocurai/web",
    "build:api": "turbo run build --filter=@xprocurai/api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "type-check": "turbo run type-check",
    "db:generate": "npm run db:generate --workspace=@xprocurai/web",
    "db:push": "npm run db:push --workspace=@xprocurai/web",
    "db:migrate": "npm run db:migrate --workspace=@xprocurai/web",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=@xprocurai/web",
    "db:studio": "npm run db:studio --workspace=@xprocurai/web",
    "start:prod": "npm run start --workspace=@xprocurai/web",
    "deploy:check": "npm run build:web && echo 'Build successful — ready for deployment'",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
